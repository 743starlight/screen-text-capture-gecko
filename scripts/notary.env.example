# 写して scripts/notary.env として保存し、値を埋める（scripts/notary.env は .gitignore の対象。コミットしない）。
# キーチェーンのプロファイル（xcrun notarytool store-credentials）を使うなら、このファイルは要らない。
# アプリ用パスワードは https://account.apple.com/account/manage で、この Apple ID 用に発行する
APPLE_ID="your-apple-id@example.com"
APPLE_TEAM_ID="YOURTEAMID"
APPLE_APP_PASSWORD="xxxx-xxxx-xxxx-xxxx"
